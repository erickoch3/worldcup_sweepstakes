{
  "name": "worldcup-sweepstakes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:prepare": "node scripts/ensure-sqlite-db.mjs",
    "db:migrate": "npm run db:prepare && prisma migrate dev",
    "db:deploy": "npm run db:prepare && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx scripts/seed-local-demo-data.ts",
    "sync:worldcup": "tsx scripts/sync-worldcup-data.ts",
    "verify": "npm run db:generate && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "17.2.3",
    "lucide-react": "1.17.0",
    "next": "16.2.9",
    "next-auth": "4.24.14",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "jsdom": "25.0.1",
    "prisma": "7.8.0",
    "tsx": "4.20.4",
    "typescript": "5.6.3",
    "vitest": "4.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "uuid": "11.1.1",
    "postcss": "8.5.10",
    "@hono/node-server": "1.19.13"
  }
}
