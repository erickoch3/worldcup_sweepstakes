generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accounts             Account[]
  sessions             Session[]
  invitesUsed          Invite[]              @relation("InviteUsedBy")
  preferenceSubmission PreferenceSubmission?
  assignments          Assignment[]
  processedDrafts      Draft[]               @relation("DraftProcessedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invite {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  label         String?
  intendedEmail String?
  expiresAt     DateTime?
  usedAt        DateTime?
  usedById      String?
  maxUses       Int?      @default(1)
  useCount      Int       @default(0)
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  usedBy        User?     @relation("InviteUsedBy", fields: [usedById], references: [id])
}

model Team {
  id                String             @id @default(cuid())
  countryCode       String             @unique
  displayName       String
  groupName         String?
  bracketSeed       String?
  decimalOdds       Float
  oddsUpdatedAt     DateTime?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  preferenceChoices PreferenceChoice[]
  assignments       Assignment[]
  matchesAsTeamA    Match[]            @relation("MatchTeamA")
  matchesAsTeamB    Match[]            @relation("MatchTeamB")
  matchesWon        Match[]            @relation("MatchWinner")
  oddsSnapshots     TeamOddsSnapshot[]
}

model PreferenceSubmission {
  id        String             @id @default(cuid())
  userId    String             @unique
  lockedAt  DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  choices   PreferenceChoice[]
}

model PreferenceChoice {
  id           String               @id @default(cuid())
  submissionId String
  teamId       String
  rank         Int
  submission   PreferenceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  team         Team                 @relation(fields: [teamId], references: [id])

  @@unique([submissionId, rank])
  @@unique([submissionId, teamId])
}

model PreferenceSubmissionArchive {
  id                   String    @id @default(cuid())
  originalSubmissionId String
  userId               String
  userEmail            String?
  userName             String?
  choicesJson          String
  lockedAt             DateTime?
  submittedAt          DateTime
  deletedById          String?
  deletedAt            DateTime  @default(now())

  @@index([originalSubmissionId])
  @@index([userId])
  @@index([deletedAt])
}

model Draft {
  id            String       @id @default(cuid())
  status        DraftStatus  @default(LOCKED)
  processedById String?
  processedAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  processedBy   User?        @relation("DraftProcessedBy", fields: [processedById], references: [id])
  assignments   Assignment[]

  @@unique([status])
}

model Assignment {
  id                       String   @id @default(cuid())
  draftId                  String
  userId                   String
  teamId                   String
  preferenceRankWon        Int?
  pickNumber               Int?
  teamShareIndex           Int      @default(1)
  teamShareCount           Int      @default(1)
  normalizedWinProbability Float    @default(0)
  buyInPence               Int
  createdAt                DateTime @default(now())
  draft                    Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                     Team     @relation(fields: [teamId], references: [id])

  @@unique([draftId, teamId, teamShareIndex])
  @@index([draftId, userId])
  @@index([draftId, teamId])
}

model Match {
  id                      String      @id @default(cuid())
  matchNumber             Int?        @unique
  resultProvider          String?
  resultProviderFixtureId String?
  teamAId                 String
  teamBId                 String
  kickoffAt               DateTime
  stage                   String
  status                  MatchStatus @default(SCHEDULED)
  teamAScore              Int?
  teamBScore              Int?
  winnerTeamId            String?
  penaltySummary          String?
  resultSyncedAt          DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  teamA                   Team        @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamB                   Team        @relation("MatchTeamB", fields: [teamBId], references: [id])
  winnerTeam              Team?       @relation("MatchWinner", fields: [winnerTeamId], references: [id])

  @@unique([teamAId, teamBId, kickoffAt])
  @@unique([resultProvider, resultProviderFixtureId])
}

model TeamOddsSnapshot {
  id                 String    @id @default(cuid())
  teamId             String
  provider           String
  sourceEventId      String
  sourceSportKey     String
  sourceLastUpdate   DateTime?
  sampledAt          DateTime
  bookmakerKey       String
  bookmakerTitle     String
  marketKey          String
  outcomeName        String
  decimalOdds        Float
  impliedProbability Float
  createdAt          DateTime  @default(now())
  team               Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([provider, sourceEventId, bookmakerKey, marketKey, teamId, sampledAt])
  @@index([teamId, sampledAt])
  @@index([provider, sampledAt])
}

model DataSyncRun {
  id           String            @id @default(cuid())
  provider     String
  kind         String
  status       DataSyncRunStatus @default(RUNNING)
  fetchedCount Int               @default(0)
  appliedCount Int               @default(0)
  message      String?
  startedAt    DateTime          @default(now())
  finishedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([provider, kind, startedAt])
  @@index([status, startedAt])
}

enum DraftStatus {
  LOCKED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINAL
  POSTPONED
  CANCELLED
}

enum DataSyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
}
